#!/bin/sh
# Commit messages follow Conventional Commits (CLAUDE.md, scripts/release.py): versions
# are computed from them. « type(portée): description en français ».
msg_file="$1"
subject=$(head -n 1 "$msg_file")

case "$subject" in
  "fusionne "*|"Merge "*|"Revert "*) exit 0 ;;  # merges and git's own reverts
esac

if ! printf '%s' "$subject" | grep -Eq '^(feat|fix|perf|refactor|docs|test|build|chore|style|revert)(\([a-z0-9-]+\))?!?: .+'; then
  echo "✗ Message de commit hors convention : « $subject »" >&2
  echo "  Attendu : type(portée): description, ex. « feat(transcription): ajoute … »" >&2
  echo "  Types : feat, fix, perf, refactor, docs, test, build, chore, style, revert ;" >&2
  echo "  « ! » après la portée pour un changement incompatible (version majeure)." >&2
  exit 1
fi

exit 0
