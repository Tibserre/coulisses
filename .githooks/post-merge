#!/bin/sh
# After a merge into main, publish the version it brings (scripts/release.py): next
# version from the merged commits, CHANGELOG.md, version files, tag. Nothing to publish:
# nothing happens.
[ "$(git rev-parse --abbrev-ref HEAD)" = "main" ] || exit 0
# uv picks a Python >= 3.11 (tomllib) whatever the PATH of the git client.
if ! uv run --no-project --python ">=3.11" "$(git rev-parse --show-toplevel)/scripts/release.py"; then
  echo "✗ Version NON publiée : voir le message ci-dessus, puis relancer scripts/release.py." >&2
fi
