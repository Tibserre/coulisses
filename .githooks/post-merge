#!/bin/sh
# After a merge into main, the « Non publié » section of CHANGELOG.md says what the next
# publication brings (scripts/release.py): no version, no tag (ADR 0064, numbered by
# scripts/publier.py --numeroter). Nothing new: nothing happens.
[ "$(git rev-parse --abbrev-ref HEAD)" = "main" ] || exit 0
# uv picks a Python >= 3.11 (tomllib) whatever the PATH of the git client.
if ! uv run --no-project --python ">=3.11" "$(git rev-parse --show-toplevel)/scripts/release.py"; then
  echo "✗ CHANGELOG.md NON mis à jour : voir le message ci-dessus, puis relancer scripts/release.py." >&2
fi
